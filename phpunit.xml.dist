<?xml version="1.0" encoding="UTF-8"?>
<phpunit controlGarbageCollector="true" numberOfTestsBeforeGarbageCollection="10" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php" colors="true"
         failOnWarning="true" failOnRisky="true" failOnEmptyTestSuite="true">
    <testsuites>
        <testsuite name="Ownership"><directory>tests</directory></testsuite>
    </testsuites>
    <source><include><directory suffix=".php">src</directory></include></source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE="/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
    </php>
</phpunit>
